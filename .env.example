# Leave as command names when FFmpeg and FFprobe are on PATH, or set full paths.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Local Ollama connection and default models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
REASONING_MODEL=qwen3:8b
VISION_MODEL=qwen3.5:4b

# Faster-Whisper configuration.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8

# Replace both placeholders before starting the dashboard. Keep .env private and untracked.
AUTH_ENABLED=true
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=change-me

# Exact frontend origins allowed to call this local API. Keep the list narrow.
BACKEND_CORS_ORIGINS=https://gta-clip-command.vercel.app,https://v0-gta-clip-command-nologin.vercel.app,http://127.0.0.1:8000,http://localhost:8000

