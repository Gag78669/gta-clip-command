# Leave as command names when FFmpeg and FFprobe are on PATH, or set full paths.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Local Ollama connection and default models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
REASONING_MODEL=qwen3:8b
VISION_MODEL=qwen3.5:4b

# Faster-Whisper configuration.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8

# Hosted deployment (leave AUTH_ENABLED=false for the local single-user dashboard).
AUTH_ENABLED=false
DATABASE_URL=sqlite:///data/gta_clip.db
REDIS_URL=
FRONTEND_ORIGIN=http://127.0.0.1:8000
DAILY_FREE_SECONDS=1200
MAX_VIDEO_SECONDS=600

# The platform Groq key is optional; users can also set their own hosted key in Settings.
GROQ_API_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUD_KEY_ENCRYPTION_KEY=

# S3-compatible object storage (required in hosted mode; Cloudflare R2 or AWS S3).
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# SMTP used to send email-verification links in hosted mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
